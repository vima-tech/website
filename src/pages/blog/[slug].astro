---
import Layout from '../../layouts/Layout.astro';
import MarkdownContent from '../../components/MarkdownContent.astro';
import PortableText from '../../components/PortableText.astro';
import CatShape from '../../components/CatShape.astro';
import { fetchSanity, postBySlugQuery } from '../../lib/sanity';

export const prerender = false;

const { slug } = Astro.params;
const post = await fetchSanity<any>(postBySlugQuery, { slug });

let newer: any = null;
let older: any = null;
if (post) {
  const near = await fetchSanity<{ newer: any; older: any }>(
    `{
      "newer": *[_type == "post" && publishedAt > $at] | order(publishedAt asc)[0]{title, "slug": slug.current},
      "older": *[_type == "post" && publishedAt < $at] | order(publishedAt desc)[0]{title, "slug": slug.current}
    }`,
    { at: post.publishedAt ?? '' },
  ).catch(() => ({ newer: null, older: null }));
  newer = near.newer;
  older = near.older;
} else {
  Astro.response.status = 404;
}

const cats = (post?.categories ?? []).filter(Boolean);
const date = post?.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Shanghai' })
  : '';
---

<Layout
  title={post ? `${post.title.trim()} · 任孟锴` : '文章不存在 · 任孟锴'}
  description={post?.excerpt}
  image={post?.coverImage}
>
  {
    !post ? (
      <section class="wrap py-24">
        <h1 class="h1">这篇文章不存在</h1>
        <p class="lead mt-4">
          链接里的 <code class="rounded bg-paper-2 px-2 py-0.5">{slug}</code> 没有对应的文章，可能已经改名或删除。
        </p>
        <a href="/blog" class="pill mt-8">回到文章列表</a>
      </section>
    ) : (
      <div class="progress" aria-hidden="true"><span data-progress /></div>
      <article class="wrap pb-16 pt-8 md:pb-24 md:pt-12">
        <div class="mx-auto max-w-[760px]">
          <a href="/blog" class="back meta">← 博客</a>
          <header class="mt-6">
            {cats.length > 0 && (
              <div class="flex flex-wrap gap-4">
                {cats.map((c: any) => (
                  <a href={`/blog?category=${c.slug?.current ?? c.slug}`} class="cat">
                    <CatShape title={c.title} />
                    {c.title}
                  </a>
                ))}
              </div>
            )}
            <h1 class="post-h1 mt-4">{post.title.trim()}</h1>
            <p class="meta mt-4 num">
              <time datetime={post.publishedAt}>{date}</time>
              {post.author?.name && <span> · {post.author.name}</span>}
            </p>
            {post.excerpt && <p class="summary">{post.excerpt}</p>}
          </header>

          {post.coverImage && (
            <img src={post.coverImage} alt="" class="mt-10 aspect-video w-full rounded-[10px] object-cover" loading="eager" />
          )}

          <div class="mt-10">
            {typeof post.body === 'string' ? (
              <MarkdownContent content={post.body} />
            ) : (
              <div class="article">
                <PortableText blocks={post.body} />
              </div>
            )}
          </div>

          {(newer || older) && (
            <nav aria-label="相邻文章" class="near">
              {older ? (
                <a href={`/blog/${older.slug}`} class="near-link">
                  <span class="meta">← 更早一篇</span>
                  <span class="near-title">{older.title.trim()}</span>
                </a>
              ) : (
                <span />
              )}
              {newer && (
                <a href={`/blog/${newer.slug}`} class="near-link md:text-right">
                  <span class="meta">更新一篇 →</span>
                  <span class="near-title">{newer.title.trim()}</span>
                </a>
              )}
            </nav>
          )}
        </div>
      </article>
    )
  }
</Layout>

<style>
  /* 阅读进度：贴在顶栏下方的一条线 */
  .progress {
    position: sticky;
    top: 64px;
    z-index: 40;
    height: 3px;
    margin-bottom: -3px;
    background: transparent;
  }

  @media (min-width: 768px) {
    .progress {
      top: 80px;
    }
  }

  .progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--line-factory);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }

  .back {
    font-weight: 700;
  }

  .back:hover {
    color: var(--ink);
  }

  .cat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--ink-2);
  }

  .cat:hover {
    color: var(--ink);
  }

  .post-h1 {
    font-size: 30px;
    font-weight: 850;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .post-h1 {
      font-size: 44px;
      line-height: 1.22;
    }
  }

  .summary {
    margin-top: 24px;
    padding: 18px 22px;
    border-radius: 10px;
    background: var(--paper-2);
    font-size: var(--fs-base);
    line-height: 1.8;
    color: var(--ink-2);
  }

  .near {
    display: grid;
    gap: 16px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 2px solid var(--ink);
  }

  @media (min-width: 768px) {
    .near {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }

  .near-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .near-title {
    font-weight: 800;
    line-height: 1.5;
  }

  .near-link:hover .near-title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const article = document.querySelector('article');
  if (bar && article) {
    const update = () => {
      const r = article.getBoundingClientRect();
      const total = r.height - window.innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
      bar.style.setProperty('--p', p.toFixed(4));
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }
</script>
