---
import Layout from '../../layouts/Layout.astro';
import PostRow from '../../components/PostRow.astro';
import CatShape from '../../components/CatShape.astro';
import { fetchSanity } from '../../lib/sanity';

export const prerender = false;

const query = `{
  "posts": *[_type == "post"] | order(publishedAt desc) {
    _id, title, slug, excerpt, publishedAt,
    categories[]->{title, "slug": slug.current}
  },
  "categories": *[_type == "category" && (usedFor == "blog" || usedFor == "both")] | order(title asc) {
    title, "slug": slug.current
  }
}`;

let posts: any[] = [];
let categories: { title: string; slug: string }[] = [];
let loadFailed = false;
try {
  const res = await fetchSanity<{ posts: any[]; categories: any[] }>(query);
  posts = res.posts ?? [];
  categories = (res.categories ?? []).filter((c) => c.slug);
} catch {
  loadFailed = true;
}

const selected = Astro.url.searchParams.get('category') ?? '';
const countOf = (slug: string) => posts.filter((p) => p.categories?.some((c: any) => c?.slug === slug)).length;
const shown = selected ? posts.filter((p) => p.categories?.some((c: any) => c?.slug === selected)) : posts;

// 按年份分组
const byYear = new Map<string, any[]>();
for (const p of shown) {
  const y = p.publishedAt?.slice(0, 4) ?? '未注明日期';
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}
---

<Layout title="博客 · 任孟锴" description="需求怎么拆、AI 编码代理怎么管、系统怎么上线：做项目时写下来的笔记和操作手册。">
  <section class="wrap pb-8 pt-10 md:pb-10 md:pt-16">
    <h1 class="h1">博客</h1>
    <p class="lead mt-4 max-w-[34em]">
      做项目时写下来的东西：需求怎么拆、AI 编码代理怎么管、环境怎么搭、系统怎么上线。
    </p>

    <div class="mt-8 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <nav aria-label="按分类筛选" class="flex flex-wrap gap-2">
        <a href="/blog" class="chip" aria-current={selected === '' ? 'true' : undefined}>
          全部 <span class="num opacity-70">{posts.length}</span>
        </a>
        {
          categories.map((c) => (
            <a href={`/blog?category=${c.slug}`} class="chip" aria-current={selected === c.slug ? 'true' : undefined}>
              <CatShape title={c.title} />
              {c.title} <span class="num opacity-70">{countOf(c.slug)}</span>
            </a>
          ))
        }
      </nav>
      <label class="search">
        <span class="sr-only">搜索文章标题</span>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="2.4"></circle>
          <path d="M13 13 L18 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
        </svg>
        <input id="post-search" type="search" placeholder="搜索标题" autocomplete="off" />
      </label>
    </div>
  </section>

  <section class="wrap pb-16 md:pb-24">
    {loadFailed && <p class="py-10 text-ink-2">文章列表暂时没加载出来，稍后刷新试试。</p>}
    {!loadFailed && shown.length === 0 && <p class="py-10 text-ink-2">这个分类下还没有文章。</p>}

    {
      [...byYear.entries()].map(([year, list]) => (
        <div class="year-block" data-year-block>
          <h2 class="year num">
            {year}
            <span class="year-count">{list.length} 篇</span>
          </h2>
          <div>
            {list.map((p) => (
              <div data-post-title={p.title.trim().toLowerCase()}>
                <PostRow post={p} />
              </div>
            ))}
          </div>
        </div>
      ))
    }
    <p id="search-empty" class="hidden py-10 text-ink-2">没有标题里含这个词的文章。</p>
  </section>
</Layout>

<style>
  .search {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-3);
    box-shadow: inset 0 0 0 2px var(--rule);
    transition: box-shadow 140ms;
  }

  .search:focus-within {
    box-shadow: inset 0 0 0 2px var(--focus);
  }

  .search input {
    width: 100%;
    min-width: 0;
    background: transparent;
    color: var(--ink);
    font-size: var(--fs-sm);
    outline: none;
  }

  @media (min-width: 768px) {
    .search {
      width: 260px;
    }
  }

  .year-block + .year-block {
    margin-top: 48px;
  }

  .year {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--ink);
    font-size: var(--fs-lg);
    font-weight: 850;
    font-stretch: 115%;
  }

  .year-count {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--ink-3);
  }
</style>

<script>
  const input = document.getElementById('post-search') as HTMLInputElement | null;
  const empty = document.getElementById('search-empty');
  let timer: number | undefined;

  input?.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      const kw = input.value.trim().toLowerCase();
      let visible = 0;
      document.querySelectorAll<HTMLElement>('[data-year-block]').forEach((block) => {
        let inBlock = 0;
        block.querySelectorAll<HTMLElement>('[data-post-title]').forEach((row) => {
          const hit = !kw || (row.dataset.postTitle ?? '').includes(kw);
          row.hidden = !hit;
          if (hit) inBlock++;
        });
        block.hidden = inBlock === 0;
        visible += inBlock;
      });
      empty?.classList.toggle('hidden', visible > 0);
    }, 150);
  });
</script>
