---
import Layout from '../layouts/Layout.astro';

const ways = [
  {
    shape: 'square',
    title: '先把需求写成能验收的条目',
    text: '每条需求有编号和验收标准，开工前先过一遍资料缺口和前后矛盾。代码里每处实现都要能反查到是哪条需求要的，反查不到就不写。',
  },
  {
    shape: 'circle',
    title: '代码交给 AI 编码代理，我管取舍',
    text: '需求拆成任务包分给编码代理并行做，我负责定边界、拍板和验收。一个人能同时推进几条线，靠的是这套分工，不是加班。',
  },
  {
    shape: 'triangle',
    title: '交付以能跑为准',
    text: '用真实数据库、真实浏览器验证，不拿文档和 mock 当结论。交付时离线上线包、部署脚本、操作演示视频一起给。',
  },
];

const stack = [
  { k: '后端', v: 'Java 21 · Spring Boot · PostgreSQL · Node.js · SQLite' },
  { k: '前端', v: 'Vue 3 · React Router · Astro · 微信小程序' },
  { k: '数据', v: 'Python 数据整理与调研流水线' },
  { k: '协作', v: 'Claude Code 等 AI 编码代理，需求文档 → 契约 → 验收的文档链' },
];
---

<Layout title="关于 · 任孟锴" description="任孟锴，石家庄的一人公司：怎么做事、常用的技术和现在在做的项目。">
  <section class="wrap grid gap-10 pb-12 pt-10 md:grid-cols-[1.3fr_1fr] md:items-center md:gap-16 md:pt-16">
    <div>
      <h1 class="h1">你好，我是任孟锴</h1>
      <div class="lead mt-6 max-w-[32em] space-y-4">
        <p>在石家庄，全职经营自己的一人公司——纬蚂科技（上海）有限公司（OPC，One Person Company）。</p>
        <p>
          现在手上是三件事：做河北源头工厂名录<a href="https://hebeigongchang.cn" target="_blank" rel="noopener noreferrer" class="ink-link font-bold text-ink">河北工厂网</a>，做校服直售的小程序商城校服SHOP，和 HIS 厂商一起做医院周边的营养、输血、审方、随访系统，以及把它们收拢起来的底座 MedAtlas。
        </p>
        <p>博客写的是这些项目里攒下的做法和踩过的坑。</p>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/projects" class="pill">看在做的项目<svg class="arr" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <a href="/contact" class="pill pill-ghost">联系我</a>
      </div>
    </div>

    <div class="portrait mx-auto w-full max-w-[360px]">
      <span class="p-square" aria-hidden="true"></span>
      <span class="p-dot" aria-hidden="true"></span>
      <img src="/images/founder.jpg" alt="任孟锴的照片" width="540" height="676" loading="eager" />
    </div>
  </section>

  <section class="band">
    <div class="wrap py-14 md:py-20">
      <h2 class="h2">怎么做事</h2>
      <ol class="mt-8 grid gap-10 md:grid-cols-3 md:gap-12">
        {
          ways.map((w) => (
            <li>
              <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true" class="way-shape">
                {w.shape === 'square' && <rect x="2" y="2" width="24" height="24" rx="3" fill="var(--line-uniform)" />}
                {w.shape === 'circle' && <circle cx="14" cy="14" r="12" fill="var(--line-factory)" />}
                {w.shape === 'triangle' && <path d="M14 2 L27 26 L1 26 Z" fill="var(--line-medatlas)" />}
              </svg>
              <h3 class="h3 mt-4">{w.title}</h3>
              <p class="mt-3 text-ink-2">{w.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="wrap py-14 md:py-20">
    <h2 class="h2">常用的东西</h2>
    <dl class="mt-6 border-t-2 border-ink">
      {
        stack.map((s) => (
          <div class="stack-row">
            <dt class="font-bold">{s.k}</dt>
            <dd class="text-ink-2">{s.v}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</Layout>

<style>
  .portrait {
    position: relative;
    padding: 0 24px 24px 0;
  }

  .portrait img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 540 / 676;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: 180px 180px 10px 10px;
    filter: saturate(0.92) contrast(1.04);
  }

  .p-square {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 72%;
    height: 62%;
    border-radius: 10px;
    background: var(--line-factory);
    box-shadow: 6px 8px 0 var(--shadow-ink);
  }

  .p-dot {
    position: absolute;
    left: -18px;
    top: 30%;
    z-index: 1;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--line-nutrition);
    box-shadow: 4px 6px 0 var(--shadow-ink);
  }

  :global(html.js) .p-square {
    animation: slide-in 560ms var(--ease-pop) 120ms both;
  }

  :global(html.js) .p-dot {
    animation: pop-in 520ms var(--ease-pop) 320ms both;
  }

  @keyframes slide-in {
    from {
      transform: translate(-24px, -24px);
    }
    to {
      transform: none;
    }
  }

  @keyframes pop-in {
    from {
      transform: scale(0);
    }
    to {
      transform: scale(1);
    }
  }

  .band {
    background: var(--paper-2);
  }

  .stack-row {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 768px) {
    .stack-row {
      grid-template-columns: 140px 1fr;
    }
  }
</style>
