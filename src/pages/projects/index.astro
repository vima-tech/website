---
import Layout from '../../layouts/Layout.astro';
import Metro from '../../components/Metro.astro';
import { worklines, formatDate } from '../../data/worklines';
import { tools } from '../../data/tools';
import { fetchSanity } from '../../lib/sanity';

export const prerender = false;

let others: any[] = [];
try {
  others = await fetchSanity<any[]>(
    `*[_type == "project"] | order(order asc) { _id, title, "slug": slug.current, description, technologies, liveUrl }`,
  );
} catch {
  others = [];
}

const groups = [
  { title: '自己的产品', intro: '', lines: worklines.filter((l) => l.group === 'product') },
  {
    title: 'MedAtlas 线组 · 医院周边系统',
    intro:
      '和 HIS 厂商一起做的一组专业系统。审方、营养、输血先各自做成能上线的独立系统，MedAtlas 是后来立起来的共用底座，把它们按功能逐项归集；随访是第一个直接在底座上开发的产品。',
    lines: worklines.filter((l) => l.group === 'medatlas'),
  },
];

// 描述里的 emoji 不展示
const clean = (s?: string) => (s ?? '').replace(/\p{Extended_Pictographic}️?/gu, '').trim();
---

<Layout title="工作 · 任孟锴" description="正在做的项目：河北工厂网、校服SHOP、MedAtlas 医院周边系统（营养、输血、审方、随访）。">
  <section class="wrap pb-10 pt-10 md:pt-16">
    <h1 class="h1">工作</h1>
    <p class="lead mt-4 max-w-[36em]">
      现在同时在做的事，按线路排。站点日期取自各项目的提交记录；涉及医院和客户的项目只写到产品层面。
    </p>
    <div class="mt-10">
      <Metro />
    </div>
  </section>

  {
    groups.map((g) => (
      <section class="wrap pt-14">
        <h2 class="group-h">{g.title}</h2>
        {g.intro && <p class="mt-3 max-w-[40em] text-ink-2">{g.intro}</p>}
        {g.lines.map((l) => (
          <article id={l.id} class="line" style={`--c:var(${l.color})`}>
            <div>
              <span class="line-bar" />
              <h3 class="line-name">{l.name}</h3>
              <p class="line-summary">{l.summary}</p>
              <p class="line-status">
                <strong>现在：</strong>
                {l.status}
              </p>
              {l.link && (
                <a href={l.link.href} target="_blank" rel="noopener noreferrer" class="ink-link mt-4 inline-block font-bold">
                  {l.link.label} ↗
                </a>
              )}
            </div>
            <ol class="stops">
              {l.stations.map((s) => (
                <li class:list={['stop', { major: s.major }]}>
                  <span class="stop-date num">{formatDate(s.date)}</span>
                  <span>{s.text}</span>
                </li>
              ))}
            </ol>
          </article>
        ))}
      </section>
    ))
  }

  <section id="tools" class="wrap pt-14">
    <h2 class="group-h">AI 工具沉淀</h2>
    <p class="mt-3 max-w-[40em] text-ink-2">
      做项目时顺手沉淀下来的：两个开源项目、几个给编码代理用的技能，和还在探索的方向。
    </p>
    <ul class="mt-2">
      {
        tools.map((t) => (
          <li>
            {t.link ? (
              <a href={t.link} target="_blank" rel="noopener noreferrer" class="tool row-bleed">
                <span class="tool-meta meta">
                  {t.kind}
                  {t.since && <span class="num"> · {t.since.replace('-', '.')} 起</span>}
                </span>
                <span class="min-w-0">
                  <span class="tool-name">{t.name} ↗</span>
                  <span class="tool-text">{t.text}</span>
                </span>
              </a>
            ) : (
              <div class="tool">
                <span class="tool-meta meta">
                  {t.kind}
                  {t.since && <span class="num"> · {t.since.replace('-', '.')} 起</span>}
                </span>
                <span class="min-w-0">
                  <span class="tool-name">{t.name}</span>
                  <span class="tool-text">{t.text}</span>
                </span>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  {
    others.length > 0 && (
      <section class="wrap pb-20 pt-16">
        <h2 class="group-h">更早的作品</h2>
        <ul class="mt-2">
          {others.map((p) => (
            <li>
              <a href={`/projects/${p.slug}`} class="other row-bleed">
                <span class="other-title">{p.title}</span>
                <span class="text-ink-2">{clean(p.description)}</span>
                {p.technologies?.length > 0 && <span class="meta">{p.technologies.join(' · ')}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  {others.length === 0 && <div class="pb-20" />}
</Layout>

<style>
  .group-h {
    font-size: var(--fs-lg);
    font-weight: 850;
    font-stretch: 112%;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--ink);
  }

  .line {
    display: grid;
    gap: 24px;
    padding: 36px 0;
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 96px;
  }

  @media (min-width: 900px) {
    .line {
      grid-template-columns: 1.1fr 1fr;
      gap: 64px;
    }
  }

  .line:target {
    background: linear-gradient(90deg, color-mix(in srgb, var(--c) 10%, transparent), transparent 70%);
  }

  .line-bar {
    display: block;
    width: 56px;
    height: 12px;
    border-radius: 999px;
    background: var(--c);
  }

  .line-name {
    margin-top: 16px;
    font-size: var(--fs-lg);
    font-weight: 850;
    line-height: 1.3;
  }

  .line-summary {
    margin-top: 10px;
    max-width: 34em;
    color: var(--ink-2);
  }

  .line-status {
    margin-top: 12px;
    max-width: 34em;
    font-size: var(--fs-sm);
  }

  /* 竖向小线路 */
  .stops {
    align-self: start;
    position: relative;
    padding-left: 34px;
  }

  .stops::before {
    content: '';
    position: absolute;
    left: 9px;
    top: 10px;
    bottom: 10px;
    width: 6px;
    border-radius: 999px;
    background: var(--c);
  }

  .stop {
    position: relative;
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 8px;
    padding: 6px 0;
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .stop + .stop {
    margin-top: 6px;
  }

  .stop::before {
    content: '';
    position: absolute;
    left: -30px;
    top: 9px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: inset 0 0 0 3px var(--c);
  }

  .stop.major::before {
    left: -32px;
    top: 7px;
    width: 18px;
    height: 18px;
    box-shadow: inset 0 0 0 4px var(--ink);
  }

  .stop.major {
    font-weight: 700;
  }

  .stop-date {
    font-weight: 700;
    color: var(--ink-3);
  }

  .tool {
    display: grid;
    gap: 4px;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 768px) {
    .tool {
      grid-template-columns: 128px 1fr;
      gap: 24px;
    }
    .tool-meta {
      padding-top: 5px;
    }
  }

  .tool-meta {
    font-weight: 700;
  }

  .tool-name {
    display: block;
    font-size: var(--fs-md);
    font-weight: 800;
    line-height: 1.5;
  }

  .tool-text {
    display: block;
    margin-top: 4px;
    max-width: 40em;
    font-size: var(--fs-sm);
    line-height: 1.7;
    color: var(--ink-2);
  }

  a.tool:hover .tool-name {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  #tools {
    scroll-margin-top: 96px;
  }

  .other {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 0;
    border-bottom: 1px solid var(--rule);
  }

  .other-title {
    font-size: var(--fs-md);
    font-weight: 800;
  }

  .other:hover .other-title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
</style>
