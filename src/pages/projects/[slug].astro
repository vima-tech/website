---
import Layout from '../../layouts/Layout.astro';
import MarkdownContent from '../../components/MarkdownContent.astro';
import PortableText from '../../components/PortableText.astro';
import { fetchSanity, projectBySlugQuery } from '../../lib/sanity';

export const prerender = false;

const { slug } = Astro.params;
const project = await fetchSanity<any>(projectBySlugQuery, { slug });

if (!project) {
  return Astro.redirect('/404');
}

const tech: string[] = Array.isArray(project.technologies) ? project.technologies : [];
const description = (project.description ?? '').replace(/\p{Extended_Pictographic}️?/gu, '').trim();
---

<Layout title={`${project.title} · 任孟锴`} description={description} image={project.thumbnail}>
  <article class="wrap pb-16 pt-8 md:pb-24 md:pt-12">
    <div class="mx-auto max-w-[760px]">
      <a href="/projects" class="meta font-bold hover:text-ink">← 工作</a>
      <h1 class="h1 mt-6">{project.title}</h1>
      {description && <p class="lead mt-4">{description}</p>}
      {tech.length > 0 && <p class="meta mt-4 font-bold">{tech.join(' · ')}</p>}
      {
        (project.liveUrl || project.githubUrl) && (
          <div class="mt-6 flex flex-wrap gap-3">
            {project.liveUrl && (
              <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="pill">
                打开线上版本 ↗
              </a>
            )}
            {project.githubUrl && (
              <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="pill pill-ghost">
                看源码 ↗
              </a>
            )}
          </div>
        )
      }
    </div>

    {
      project.thumbnail && (
        <img
          src={project.thumbnail}
          alt={`${project.title} 截图`}
          class="mx-auto mt-10 aspect-video w-full max-w-[960px] rounded-[10px] object-cover"
          loading="eager"
        />
      )
    }

    {
      project.gallery?.length > 0 && (
        <div class="mx-auto mt-6 grid max-w-[960px] gap-4 md:grid-cols-2">
          {project.gallery.map((img: string) => (
            <img src={img} alt={`${project.title} 截图`} class="w-full rounded-[10px] object-cover" loading="lazy" />
          ))}
        </div>
      )
    }

    {
      project.body && (
        <div class="mx-auto mt-10 max-w-[760px]">
          {typeof project.body === 'string' ? (
            <MarkdownContent content={project.body} />
          ) : (
            <div class="article">
              <PortableText blocks={project.body} />
            </div>
          )}
        </div>
      )
    }
  </article>
</Layout>
