---
import Layout from '../layouts/Layout.astro';

const phoneNumber = import.meta.env.PUBLIC_PHONE_NUMBER || '';

const ways = [
  { label: '邮箱', value: 'renmengkai@gmail.com', href: 'mailto:renmengkai@gmail.com', color: '--line-factory' },
  ...(phoneNumber
    ? [{ label: '电话', value: phoneNumber, href: `tel:${phoneNumber.replace(/\s/g, '')}`, color: '--line-uniform' }]
    : []),
  { label: 'GitHub', value: 'renmengkai', href: 'https://github.com/renmengkai', color: '--line-medatlas' },
  { label: '地址', value: '河北省石家庄市长安区谈固大街', href: '', color: '--line-nutrition' },
];
---

<Layout title="联系 · 任孟锴" description="写信、打电话或留言给任孟锴，聊项目或文章里的做法。">
  <section class="wrap grid gap-12 pb-16 pt-10 md:grid-cols-[1fr_1.2fr] md:gap-16 md:pb-24 md:pt-16">
    <div>
      <h1 class="h1">联系</h1>
      <p class="lead mt-4 max-w-[26em]">
        想做类似的系统、对文章里的做法有疑问，都可以找我。邮件最快，一般当天回。
      </p>

      <ul class="mt-10 border-t-2 border-ink">
        {
          ways.map((w) => (
            <li class="way" style={`--c:var(${w.color})`}>
              <span class="way-dot" aria-hidden="true" />
              <span class="meta font-bold">{w.label}</span>
              {w.href ? (
                <a
                  href={w.href}
                  class="way-value ink-link"
                  {...(w.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {w.value}
                </a>
              ) : (
                <span class="way-value">{w.value}</span>
              )}
            </li>
          ))
        }
      </ul>
      <p class="meta mt-4">工作时间：周一至周五 9:00–18:00，周六 10:00–16:00</p>
    </div>

    <form id="contact-form" class="form" novalidate>
      <h2 class="h3">留言</h2>
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="name" class="label">称呼</label>
          <input id="name" name="name" type="text" class="field" autocomplete="name" maxlength="50" />
          <p id="name-error" class="err hidden" role="alert"></p>
        </div>
        <div>
          <label for="email" class="label">邮箱</label>
          <input id="email" name="email" type="email" class="field" autocomplete="email" />
          <p id="email-error" class="err hidden" role="alert"></p>
        </div>
      </div>
      <div>
        <label for="subject" class="label">想聊什么</label>
        <select id="subject" name="subject" class="field">
          <option value="">请选择</option>
          <option value="project">项目合作</option>
          <option value="tech">技术咨询</option>
          <option value="feedback">反馈建议</option>
          <option value="other">其他</option>
        </select>
        <p id="subject-error" class="err hidden" role="alert"></p>
      </div>
      <div>
        <div class="flex items-baseline justify-between">
          <label for="message" class="label">内容</label>
          <span id="char-count" class="meta num">0/2000</span>
        </div>
        <textarea id="message" name="message" rows="7" class="field resize-y" placeholder="大概说说要做什么、时间要求，或者想问的问题"
        ></textarea>
        <p id="message-error" class="err hidden" role="alert"></p>
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <button id="submit-btn" type="submit" class="pill">
          <span id="btn-text">发送留言</span>
        </button>
        <div id="form-status" class="status hidden" role="status"></div>
      </div>
    </form>
  </section>
</Layout>

<style>
  .way {
    display: grid;
    grid-template-columns: 14px 64px 1fr;
    align-items: baseline;
    gap: 12px;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }

  .way-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--c);
    align-self: center;
  }

  .way-value {
    justify-self: start;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid color-mix(in srgb, var(--rule) 60%, transparent);
    box-shadow: 8px 8px 0 var(--paper-2);
  }

  @media (min-width: 768px) {
    .form {
      padding: 36px;
    }
  }

  .label {
    display: block;
    margin-bottom: 6px;
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .err {
    margin-top: 6px;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--line-transfusion);
  }

  .status {
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .status[data-ok='true'] {
    color: var(--line-medatlas);
  }

  .status[data-ok='false'] {
    color: var(--line-transfusion);
  }

  #submit-btn:disabled {
    opacity: 0.6;
    cursor: progress;
    transform: none;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusEl = document.getElementById('form-status') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text') as HTMLSpanElement;
  const charCount = document.getElementById('char-count') as HTMLSpanElement;

  const fields = {
    name: document.getElementById('name') as HTMLInputElement,
    email: document.getElementById('email') as HTMLInputElement,
    subject: document.getElementById('subject') as HTMLSelectElement,
    message: document.getElementById('message') as HTMLTextAreaElement,
  };
  type Key = keyof typeof fields;

  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function setError(key: Key, msg: string) {
    const el = fields[key];
    const err = document.getElementById(`${key}-error`)!;
    if (msg) {
      el.setAttribute('aria-invalid', 'true');
      el.setAttribute('aria-describedby', `${key}-error`);
      err.textContent = msg;
      err.classList.remove('hidden');
    } else {
      el.removeAttribute('aria-invalid');
      err.textContent = '';
      err.classList.add('hidden');
    }
  }

  function validate(): boolean {
    const name = fields.name.value.trim();
    const email = fields.email.value.trim();
    const message = fields.message.value.trim();
    const errors: Record<Key, string> = {
      name: !name ? '请填写称呼' : name.length < 2 ? '称呼至少 2 个字' : '',
      email: !email ? '请填写邮箱' : !emailRegex.test(email) ? '邮箱格式不对' : '',
      subject: fields.subject.value ? '' : '请选择想聊什么',
      message: !message
        ? '请填写内容'
        : message.length < 10
          ? '内容至少 10 个字'
          : message.length > 2000
            ? '内容不能超过 2000 字'
            : '',
    };
    (Object.keys(errors) as Key[]).forEach((k) => setError(k, errors[k]));
    const first = (Object.keys(errors) as Key[]).find((k) => errors[k]);
    if (first) fields[first].focus();
    return !first;
  }

  function showStatus(ok: boolean, msg: string) {
    statusEl.dataset.ok = String(ok);
    statusEl.textContent = msg;
    statusEl.classList.remove('hidden');
  }

  fields.message.addEventListener('input', () => {
    const n = fields.message.value.length;
    charCount.textContent = `${n}/2000`;
    charCount.style.color = n > 2000 ? 'var(--line-transfusion)' : '';
  });

  (Object.keys(fields) as Key[]).forEach((k) => {
    fields[k].addEventListener(k === 'subject' ? 'change' : 'input', () => setError(k, ''));
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validate()) return;

    submitBtn.disabled = true;
    btnText.textContent = '发送中…';
    statusEl.classList.add('hidden');

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: fields.name.value.trim(),
          email: fields.email.value.trim(),
          subject: fields.subject.value,
          message: fields.message.value.trim(),
        }),
      });
      const result = await res.json();
      if (result.success) {
        showStatus(true, result.message || '已收到，我会尽快回复。');
        form.reset();
        charCount.textContent = '0/2000';
      } else {
        if (result.errors) {
          (Object.keys(fields) as Key[]).forEach((k) => setError(k, result.errors[k] ?? ''));
        }
        showStatus(false, result.message || '没发出去，请检查表单内容。');
      }
    } catch {
      showStatus(false, '网络出错，没发出去。可以稍后再试，或直接发邮件。');
    } finally {
      submitBtn.disabled = false;
      btnText.textContent = '发送留言';
    }
  });
</script>
