---
const year = new Date().getFullYear();
const company = '纬蚂科技（上海）有限公司';

// 备案信息
const icpNumber = '沪ICP备2026033959号-1';
const policeNumber = '冀公网安备13010202004665号';
const policeCode = '13010202004665';
---

<footer class="site-footer">
  <span class="stripe" aria-hidden="true"></span>
  <div class="wrap py-14 md:py-20">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr] md:items-end">
      <div>
        <p class="footer-ask">有类似的系统要做，或者想聊聊文章里的做法？</p>
        <a href="mailto:renmengkai@gmail.com" class="footer-mail">renmengkai@gmail.com</a>
      </div>
      <nav aria-label="页脚导航" class="flex flex-wrap gap-x-6 gap-y-2 md:justify-end">
        <a href="/blog" class="footer-link">博客</a>
        <a href="/projects" class="footer-link">工作</a>
        <a href="/about" class="footer-link">关于</a>
        <a href="/contact" class="footer-link">联系</a>
        <a href="https://github.com/renmengkai" target="_blank" rel="noopener noreferrer" class="footer-link">GitHub</a>
      </nav>
    </div>

    <div class="footer-company">
      <p class="company-name">{company}</p>
      <p class="company-note">我全职经营的一人公司（OPC）。网站上的项目和文章都出自这家公司，没有其他团队。</p>
    </div>

    <div class="footer-base">
      <span class="num">© {year} {company}</span>
      <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">{icpNumber}</a>
      <a
        href={`https://beian.mps.gov.cn/#/query/webSearch?code=${policeCode}`}
        target="_blank"
        rel="noopener noreferrer">{policeNumber}</a
      >
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #15171b;
    color: #ecede8;
    view-transition-name: site-footer;
  }

  .footer-ask {
    font-size: var(--fs-md);
    color: #b4b8be;
  }

  .footer-mail {
    display: inline-block;
    margin-top: 6px;
    font-size: clamp(24px, 4.4vw, 44px);
    font-weight: 800;
    font-stretch: 112%;
    line-height: 1.2;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
    background-image: linear-gradient(#ff5b14, #ff5b14);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 6px;
    transition: background-size 180ms var(--ease-move), color 180ms;
  }

  .footer-mail:hover {
    background-size: 100% 100%;
    color: #15171b;
  }

  .footer-link {
    font-size: var(--fs-sm);
    font-weight: 700;
    color: #ecede8;
  }

  .footer-link {
    position: relative;
  }

  .footer-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background: #f2ad00;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms var(--ease-move);
  }

  .footer-link:hover::after {
    transform: scaleX(1);
  }

  .footer-company {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid #30343b;
  }

  .company-name {
    font-size: var(--fs-md);
    font-weight: 800;
    color: #ecede8;
  }

  .company-note {
    margin-top: 4px;
    max-width: 36em;
    font-size: var(--fs-sm);
    line-height: 1.7;
    color: #959aa2;
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid #30343b;
    font-size: var(--fs-xs);
    color: #959aa2;
  }

  .footer-base a:hover {
    color: #ecede8;
  }
</style>
