---
import Mark from './Mark.astro';

const path = Astro.url.pathname;

const nav = [
  { href: '/blog', label: '博客' },
  { href: '/projects', label: '工作' },
  { href: '/about', label: '关于' },
  { href: '/contact', label: '联系' },
];

const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="site-header">
  <div class="wrap flex h-16 items-center justify-between gap-4 md:h-20">
    <a href="/" class="brand" aria-label="任孟锴 · 首页">
      <Mark size={30} />
      <span class="brand-name">任孟锴</span>
      <span class="brand-tag" title="一人公司 · 纬蚂科技（上海）有限公司">OPC</span>
    </a>
    <nav aria-label="主导航">
      <ul class="flex items-center gap-1 sm:gap-2">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link"
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 2px solid var(--ink);
    view-transition-name: site-header;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .brand-name {
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .brand-tag {
    font-size: 11px;
    font-weight: 800;
    font-stretch: 120%;
    letter-spacing: 0.08em;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 12px;
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--ink-2);
    border-radius: 999px;
    transition: color 140ms, background-color 140ms;
  }

  .nav-link:hover {
    color: var(--ink);
    background: var(--paper-2);
  }

  .nav-link[aria-current='page'] {
    color: var(--ink);
  }

  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 2px;
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    border-radius: 50%;
    background: var(--line-factory);
    animation: nav-dot 360ms var(--ease-pop) both;
  }

  @keyframes nav-dot {
    from {
      transform: scale(0);
    }
    to {
      transform: scale(1);
    }
  }

  @media (max-width: 400px) {
    .brand-tag {
      display: none;
    }
    .nav-link {
      padding: 0 9px;
    }
  }
</style>
